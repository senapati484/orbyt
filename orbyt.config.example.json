{
  "framework": "next",
  "styling": "tailwind",
  "aliases": {
    "components": "@/components/ui"
  },
  "cacheTtlMs": 86400000,
  "sources": {
    "shadcn": {
      "mode": "proxy",
      "enabled": true,
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "magicui": {
      "mode": "proxy",
      "enabled": true,
      "command": "npx",
      "args": ["@magicuidesign/mcp"]
    },
    "aceternity": {
      "mode": "adapter",
      "enabled": true,
      "baseUrl": "https://ui.aceternity.com"
    }
  }
}
